{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "ui": "@/components/shadcn",
    "utils": "@/lib/utils",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "iconLibrary": "lucide",
  "registries": {
    "@magicui": "https://magicui.design/r/{name}",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@kibo-ui": "https://www.kibo-ui.com/r/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@motion-primitives": "https://motion-primitives.com/c/{name}.json",
    "@glassyui": "https://glassyui.com/r/{name}.json",
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@smoothui": "https://smoothui.dev/r/{name}.json",
    "@eldoraui": "https://eldoraui.site/r/{name}.json",
    "@watermelon": "https://registry.watermelon.sh/r/{name}.json",
    "@skiper-ui": "https://skiper-ui.com/registry/{name}.json",
    "@shadcn-studio": "https://shadcnstudio.com/r/{style}/{name}.json",
    "@8bitcn": "https://www.8bitcn.com/r/{name}.json",
    "@tailgrids": "https://tailgrids.com/docs/r/{name}.json",
    "@jolly-ui": "https://jollyui.dev/default/{name}"
  }
}
