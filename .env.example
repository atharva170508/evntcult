# Copy to .env for local development:  cp .env.example .env
# Then put any 32+ character random string here (e.g. `openssl rand -base64 33`).
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
# Comma-separated college email domains allowed to sign in. Empty = any domain (dev only).
ALLOWED_EMAIL_DOMAINS=
# Payments are on hold in v1 (paid | unpaid, reconciled at the desk).
PAYMENTS_ENABLED=false
