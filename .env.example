# ─── Core ───────────────────────────────────────────────────────────────
# true  → dashboard runs on built-in mock data, no database or sign-in needed
# false → real Postgres + Auth.js
DEMO_MODE=true

DATABASE_URL="postgresql://evntcult:evntcult@localhost:5432/evntcult?schema=public"

# ─── Auth.js ────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional magic-link email sign-in (https://resend.com)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="EvntCult <no-reply@yourcollege.edu>"
# Optional: only allow sign-ins from these email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=""

# ─── Digital passes ─────────────────────────────────────────────────────
# HMAC secret used to sign QR pass tokens. Rotate = all passes invalidated.
PASS_SIGNING_SECRET=""

# ─── Integrations (hooks only in this pass) ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Payments are on hold — UPI fields are stored but never charged.
PAYMENTS_ENABLED=false
