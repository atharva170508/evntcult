{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evntcult",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evntcult-db",
      "database_id": "3f09c8c8-be37-4863-a04d-4fd81b39774c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAYMENTS_ENABLED": "false",
    // Comma-separated email domains allowed to sign in. Empty = any domain (dev only).
    "ALLOWED_EMAIL_DOMAINS": ""
  }
  // SESSION_SECRET is a secret: `wrangler secret put SESSION_SECRET` (prod), `.dev.vars` (local).
}
