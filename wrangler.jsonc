{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evntcult",
  "main": "worker.ts", // wraps .open-next/worker.js and adds the cron handler
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Every 5 minutes: expire unconfirmed waitlist holds and offer freed seats to the next person (worker.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Live gate count: one EventLive Durable Object per event (src/lib/live/event-live.ts),
  // exported from worker.ts. SQLite-backed Durable Objects work on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "EVENT_LIVE", "class_name": "EventLive" }]
  },
  "migrations": [{ "tag": "v1-event-live", "new_sqlite_classes": ["EventLive"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evntcult-db",
      "database_id": "3f09c8c8-be37-4863-a04d-4fd81b39774c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAYMENTS_ENABLED": "false",
    // Comma-separated email domains allowed to sign in. Empty = any domain (dev only).
    "ALLOWED_EMAIL_DOMAINS": ""
  }
  // SESSION_SECRET is a secret: `wrangler secret put SESSION_SECRET` (prod), `.dev.vars` (local).
}
